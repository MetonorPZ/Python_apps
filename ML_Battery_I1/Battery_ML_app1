from pathlib import Path

import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.impute import SimpleImputer
from sklearn.inspection import permutation_importance
from sklearn.metrics import mean_absolute_error, mean_squared_error
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder


DATA_DIR = Path(__file__).resolve().parent / "data" / "archive"
TARGET = "remaining_useful_cycles"
OUTPUT_FILE = Path(__file__).resolve().parent / "predictions.csv"

metadata = pd.read_csv(DATA_DIR / "battery_metadata.csv")
observations = pd.read_csv(DATA_DIR / "battery_observations.csv")
train_ids = pd.read_csv(DATA_DIR / "train_batteries.csv")
validation_ids = pd.read_csv(DATA_DIR / "validation_batteries.csv")
test_ids = pd.read_csv(DATA_DIR / "test_batteries.csv")

joined = metadata.merge(observations, on="battery_id", how="inner")
train_data = train_ids.merge(joined, on="battery_id", how="inner")
validation_data = validation_ids.merge(joined, on="battery_id", how="inner")
test_data = test_ids.merge(joined, on="battery_id", how="inner")

train_data = train_data.dropna(subset=[TARGET]).copy()
validation_data = validation_data.dropna(subset=[TARGET]).copy()

if train_data.empty:
    raise ValueError("No labeled training observations were found.")
if validation_data.empty:
    raise ValueError("No labeled validation observations were found.")
if test_data.empty:
    raise ValueError("No test observations were found.")

# These fields identify the split, record time, or encode the target/future outcome.
feature_columns = [
    "state_of_health_pct",
    "usage_strategy",
    "climate_zone",
    "cycle_index",
    "battery_age_days",
    "internal_resistance_mOhm",
    "chemistry",
]

for split_name, split_data in (
    ("training", train_data),
    ("validation", validation_data),
    ("test", test_data),
):
    missing_columns = set(feature_columns) - set(split_data.columns)
    if missing_columns:
        raise ValueError(
            f"{split_name.capitalize()} data is missing model features: "
            f"{sorted(missing_columns)}"
        )

if TARGET not in train_data.columns or TARGET not in validation_data.columns:
    raise ValueError(
        f"The target column '{TARGET}' must exist in training and validation data."
    )

numeric_columns = train_data[feature_columns].select_dtypes(
    include=["number", "bool"]
).columns.tolist()
categorical_columns = [
    column for column in feature_columns if column not in numeric_columns
]

preprocessor = ColumnTransformer(
    transformers=[
        (
            "numeric",
            SimpleImputer(strategy="median"),
            numeric_columns,
        ),
        (
            "categorical",
            Pipeline(
                steps=[
                    ("imputer", SimpleImputer(strategy="most_frequent")),
                    ("one_hot", OneHotEncoder(handle_unknown="ignore")),
                ]
            ),
            categorical_columns,
        ),
    ],
    remainder="drop",
)

model = Pipeline(
    steps=[
        ("preprocessor", preprocessor),
        (
            "regressor",
            GradientBoostingRegressor(
                n_estimators=100,
                learning_rate=0.1,
                max_depth=5,
                random_state=42,
            ),
        ),
    ]
)

model.fit(train_data[feature_columns], train_data[TARGET])

validation_predictions = model.predict(validation_data[feature_columns])
validation_mse = mean_squared_error(
    validation_data[TARGET], validation_predictions
)
validation_mae = mean_absolute_error(
    validation_data[TARGET], validation_predictions
)
print(f"Validation MSE: {validation_mse:.2f}")
print(f"Validation MAE: {validation_mae:.2f}")

importance = permutation_importance(
    model,
    validation_data[feature_columns],
    validation_data[TARGET],
    scoring="neg_mean_absolute_error",
    n_repeats=5,
    random_state=42,
    n_jobs=-1,
)
importance_by_feature = pd.Series(
    importance.importances_mean,
    index=feature_columns,
).sort_values(ascending=False)
print("\nPermutation importance (validation MAE increase):")
print(importance_by_feature.to_string())

final_training_data = pd.concat(
    [train_data, validation_data],
    ignore_index=True,
)
model.fit(
    final_training_data[feature_columns],
    final_training_data[TARGET],
)

test_predictions = model.predict(test_data[feature_columns])
prediction_columns = ["battery_id"]
if "cycle_index" in test_data.columns:
    prediction_columns.append("cycle_index")
if "timestamp" in test_data.columns:
    prediction_columns.append("timestamp")

predictions = test_data[prediction_columns].copy()
predictions["predicted_remaining_useful_cycles"] = test_predictions
predictions.to_csv(OUTPUT_FILE, index=False)
print(f"Saved {len(predictions)} predictions to {OUTPUT_FILE}")
